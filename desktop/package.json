{
  "name": "chickadee-desktop",
  "version": "0.10.19",
  "description": "Chickadee visual website inspection workspace",
  "author": "Chickadee contributors",
  "license": "Apache-2.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "node electron/launch.cjs",
    "package": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node tests/smoke.cjs",
    "format": "prettier --write src electron tests *.mjs *.html package.json"
  },
  "devDependencies": {
    "@xyflow/react": "12.12.0",
    "electron": "46.0.0-alpha.1",
    "electron-builder": "26.15.3",
    "lucide-react": "1.60.0",
    "playwright": "1.64.1",
    "pretendard": "1.3.9",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.chickadee.inspector",
    "productName": "Chickadee",
    "directories": {
      "output": "../artifacts/electron-0.10.19"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/shortcuts.mjs",
      "src/i18n.mjs",
      "src/locales/**/*",
      "package.json",
      "assets/app.ico",
      "assets/app-mark.png",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/app.ico",
        "to": "chickadee.ico"
      },
      {
        "from": "../artifacts/engine-0.10.19/ChickadeeEngine",
        "to": "engine"
      },
      {
        "from": "../artifacts/laya-0.10.19/ChickadeeLaya",
        "to": "laya"
      },
      {
        "from": "../artifacts/laya-model",
        "to": "laya-model"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "signExts": [
        ".dll",
        ".pyd",
        ".node"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "icon": "assets/app.ico"
    },
    "mac": {
      "icon": "assets/app-mark.png"
    },
    "asar": true
  }
}
